#!/system/bin/sh

STATE_DIR="${TSLR_STATE_DIR:-/data/adb/ts-lan-route}"
IP="${TSLR_IP_CMD:-ip}"
TAILSCALE="${TSLR_TAILSCALE_CMD:-}"
TAILSCALE_BIN_DIR="${TSLR_TAILSCALE_BIN_DIR:-/data/adb/tailscale/bin}"
PROTO=242
TABLE=52

show_help() {
    cat <<'HELP'
TS LAN Route - Tailscale Exit Node用のローカルLAN経路補完

使い方:
    su -c 'ts-lan-route <コマンド>'

コマンド:
    status       設定値と追加済み経路を表示
    plan         ローカルLAN経路の候補を確認（変更なし）
    apply        ExitNodeAllowLANAccess=trueかつExit Node有効時に
                 不足経路を追加・古い補完経路を削除
                 falseやExit Node無効時は補完経路を削除
    cleanup      本モジュールが追加した経路だけを削除
    -h, --help   このヘルプを表示

対象:
    IPv4直結LAN（10/8、172.16/12、192.168/16、169.254/16）。
    インターフェース名を固定せず、接続中のLANを検出する。
    既存のTailscale経路や他ソフトの経路は変更しない。
    tailscale debug prefsのExitNodeAllowLANAccessを必ず確認する。
    MagiskのActionからもmagisk-tailscaledのCLIを直接検出する。
    IPv6には対応しない。自動監視・自動実行はしない。

Magisk/KernelSUのActionボタンは 'apply' を1回実行する。
HELP
}

say() {
    printf '%s\n' "$*"
}

log_info() {
    say "[INFO] $*"
}

log_add() {
    say "[ADD] $*"
}

log_skip() {
    say "[SKIP] $*"
}

log_remove() {
    say "[REMOVE] $*"
}

log_warn() {
    say "[WARN] $*"
}

log_error() {
    say "[ERROR] $*" >&2
}

log_summary() {
    say "[RESULT] 追加=$added_count / 既存=$skipped_count / 削除=$removed_count / 失敗=$error_count"
}

is_root() {
    [ "$(id -u)" = 0 ] || {
        say 'エラー: rootで実行する必要がある。'
        return 1
    }
}

ensure_state() {
    mkdir -p "$STATE_DIR" || return 1
    chmod 700 "$STATE_DIR" 2>/dev/null || true
}

resolve_tailscale() {
    if [ -n "$TAILSCALE" ]; then
        case "$TAILSCALE" in
            */*) [ -x "$TAILSCALE" ] || return 1 ;;
            *) command -v "$TAILSCALE" >/dev/null 2>&1 || return 1 ;;
        esac
        return 0
    fi
    for candidate in \
        "$TAILSCALE_BIN_DIR/tailscale" \
        /data/adb/modules/magisk-tailscaled/system/bin/tailscale \
        /dev/tailscale \
        /system/bin/tailscale; do
        if [ -x "$candidate" ]; then
            TAILSCALE="$candidate"
            return 0
        fi
    done
    TAILSCALE=$(command -v tailscale 2>/dev/null) || return 1
    [ -n "$TAILSCALE" ]
}

prefs_state() {
    if ! resolve_tailscale; then
        say 'Tailscale CLIが見つからない。magisk-tailscaledのインストール状態を確認してほしい。' >&2
        return 1
    fi
    if [ -d /data/adb/tailscale ]; then
        HOME=/data/adb/tailscale
        export HOME
    fi
    prefs=$("$TAILSCALE" debug prefs 2>/dev/null) || {
        say "Tailscale CLIの実行に失敗: $TAILSCALE debug prefs" >&2
        say "rootシェルで上記コマンドを実行し、tailscaledとの接続を確認してほしい。" >&2
        return 1
    }
    enabled=$(printf '%s\n' "$prefs" | awk '
        match($0, /"ExitNodeAllowLANAccess"[[:space:]]*:[[:space:]]*(true|false)/) {
            value = substr($0, RSTART, RLENGTH)
            sub(/^.*:[[:space:]]*/, "", value)
            print value
            exit
        }
    ')
    case "$enabled" in
        true|false) printf '%s\n' "$enabled" ;;
        *)
            say "Tailscaleの設定出力にExitNodeAllowLANAccessが見つからない: $TAILSCALE" >&2
            return 1
            ;;
    esac
}

exit_route_ready() {
    "$IP" -4 route show table "$TABLE" 2>/dev/null | grep -Eq '^default[[:space:]]+dev[[:space:]]+tailscale0([[:space:]]|$)'
}

collect_candidates() {
    "$IP" -4 -o route show table all 2>/dev/null | awk '
        $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ {
            cidr = $1
            dev = ""
            scope = ""
            table = "main"
            for (i = 2; i <= NF; i++) {
                if ($i == "dev") dev = $(i + 1)
                if ($i == "scope") scope = $(i + 1)
                if ($i == "table") table = $(i + 1)
            }
            if (dev == "" || scope != "link" || table == "52" || table == "local") next
            if (dev ~ /^(lo|dummy|tailscale|tun|tap|wg|rmnet|ccmni|ccmni|pdp|wwan|v4-|clat|ipsec|xfrm|ip6tnl|sit|gre|gretap|erspan|veth|docker|podman)/) next
            split(cidr, octets, /[.\/]/)
            a = octets[1] + 0
            b = octets[2] + 0
            if (!(a == 10 || (a == 172 && b >= 16 && b <= 31) || (a == 192 && b == 168) || (a == 169 && b == 254))) next
            print cidr "|" dev
        }
    ' | sort -u
}

managed_routes() {
    "$IP" -4 -o route show table "$TABLE" 2>/dev/null | awk -v proto="$PROTO" '
        $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/ {
            dev = ""
            managed = 0
            for (i = 2; i <= NF; i++) {
                if ($i == "dev") dev = $(i + 1)
                if ($i == "proto" && $(i + 1) == proto) managed = 1
            }
            if (managed && dev != "") print $1 "|" dev
        }
    ' | sort -u
}

route_present() {
    target="$1"
    "$IP" -4 -o route show table "$TABLE" 2>/dev/null | awk -v c="$target" '
        $1 == c || (($1 == "throw" || $1 == "blackhole" || $1 == "unreachable" || $1 == "prohibit") && $2 == c) {
            found = 1
        }
        END { exit found ? 0 : 1 }
    '
}

remove_managed() {
    managed_routes > "$managed_file" || return 1
    if [ ! -s "$managed_file" ]; then
        log_info '本モジュールの削除対象経路なし'
        return 0
    fi
    while IFS='|' read -r cidr dev; do
        [ -n "$cidr" ] && [ -n "$dev" ] || continue
        if output=$("$IP" -4 route del "$cidr" dev "$dev" proto "$PROTO" table "$TABLE" 2>&1); then
            log_remove "$cidr dev $dev"
            removed_count=$((removed_count + 1))
        else
            log_error "経路を削除できない: $cidr dev $dev"
            [ -z "$output" ] || log_error "$output"
            error_count=$((error_count + 1))
        fi
    done < "$managed_file"
}

lock_sync() {
    attempts=0
    while [ "$attempts" -lt 15 ]; do
        if mkdir "$STATE_DIR/sync.lock" 2>/dev/null; then
            printf '%s\n' "$$" > "$STATE_DIR/sync.lock/pid"
            return 0
        fi
        old_pid=$(cat "$STATE_DIR/sync.lock/pid" 2>/dev/null || true)
        if [ -z "$old_pid" ] || ! kill -0 "$old_pid" 2>/dev/null; then
            rm -rf "$STATE_DIR/sync.lock"
        else
            sleep 1
        fi
        attempts=$((attempts + 1))
    done
    say '別の経路更新処理が終了しないため、中止した。' >&2
    return 1
}

sync_routes() (
    is_root || exit 1
    ensure_state || { log_error '状態保存ディレクトリを作成できない'; exit 1; }
    lock_sync || exit 1
    desired_file="$STATE_DIR/candidates.$$"
    managed_file="$STATE_DIR/managed.$$"
    trap 'rm -f "$desired_file" "$managed_file"; rm -rf "$STATE_DIR/sync.lock"' EXIT
    added_count=0
    skipped_count=0
    removed_count=0
    error_count=0
    log_info "実行: apply / IPv4ルーティングテーブル: $TABLE"
    resolve_tailscale || {
        log_error 'Tailscale CLIが見つからない。magisk-tailscaledのインストール状態を確認してほしい。'
        exit 1
    }
    log_info "Tailscale CLI: $TAILSCALE"
    state=$(prefs_state) || {
        log_error 'Tailscale設定を取得できないため、経路は変更しない。'
        exit 1
    }
    log_info "ExitNodeAllowLANAccess: $state"
    if exit_route_ready; then
        exit_active=true
        log_info "Exit Node経路: 有効 (default dev tailscale0 / table $TABLE)"
    else
        exit_active=false
        log_warn "Exit Node経路: 見つからない (table $TABLE)"
    fi
    if [ "$state" != true ] || [ "$exit_active" != true ]; then
        if [ "$state" != true ]; then
            log_warn 'LANアクセス許可が無効のため、補完経路を削除する'
        else
            log_warn 'Exit Node経路がないため、補完経路を削除する'
        fi
        remove_managed || {
            log_error '管理対象の経路を取得できない'
            exit 1
        }
        log_summary
        [ "$error_count" -eq 0 ] || exit 1
        log_info '処理完了: 追加なし'
        exit 0
    fi
    collect_candidates > "$desired_file" || {
        log_error '直結LAN経路の取得に失敗した'
        exit 1
    }
    candidate_count=$(awk 'END { print NR + 0 }' "$desired_file")
    log_info "対象の直結IPv4 LAN: $candidate_count 件"
    [ "$candidate_count" -gt 0 ] || log_warn '追加候補となる直結LANがない'
    managed_routes > "$managed_file" || {
        log_error '現在の管理対象経路を取得できない'
        exit 1
    }
    while IFS='|' read -r cidr dev; do
        [ -n "$cidr" ] && [ -n "$dev" ] || continue
        if ! grep -Fqx "$cidr|$dev" "$desired_file"; then
            if output=$("$IP" -4 route del "$cidr" dev "$dev" proto "$PROTO" table "$TABLE" 2>&1); then
                log_remove "不要になった経路: $cidr dev $dev"
                removed_count=$((removed_count + 1))
            else
                log_error "不要経路を削除できない: $cidr dev $dev"
                [ -z "$output" ] || log_error "$output"
                error_count=$((error_count + 1))
            fi
        fi
    done < "$managed_file"
    while IFS='|' read -r cidr dev; do
        [ -n "$cidr" ] && [ -n "$dev" ] || continue
        if route_present "$cidr"; then
            log_skip "$cidr dev $dev (table $TABLEに既存経路あり)"
            skipped_count=$((skipped_count + 1))
        elif output=$("$IP" -4 route add "$cidr" dev "$dev" proto "$PROTO" scope link table "$TABLE" 2>&1); then
            log_add "$cidr dev $dev (table $TABLE)"
            added_count=$((added_count + 1))
        else
            log_error "経路を追加できない: $cidr dev $dev"
            [ -z "$output" ] || log_error "$output"
            error_count=$((error_count + 1))
        fi
    done < "$desired_file"
    log_summary
    if [ "$error_count" -gt 0 ]; then
        log_error '一部の経路更新に失敗した'
        exit 1
    fi
    log_info '処理完了'
)

cleanup_routes() (
    is_root || exit 1
    ensure_state || { log_error '状態保存ディレクトリを作成できない'; exit 1; }
    lock_sync || exit 1
    managed_file="$STATE_DIR/managed.$$"
    trap 'rm -f "$managed_file"; rm -rf "$STATE_DIR/sync.lock"' EXIT
    added_count=0
    skipped_count=0
    removed_count=0
    error_count=0
    log_info "実行: cleanup / IPv4ルーティングテーブル: $TABLE"
    remove_managed || {
        log_error '管理対象の経路を取得できない'
        exit 1
    }
    log_summary
    [ "$error_count" -eq 0 ] || exit 1
    log_info '処理完了'
)

status() {
    is_root || return 1
    state=$(prefs_state 2>/dev/null) || state='取得失敗'
    if exit_route_ready; then
        ready='あり'
    else
        ready='なし'
    fi
    say "ExitNodeAllowLANAccess: $state"
    say "Exit Node経路(table $TABLE): $ready"
    say '本モジュールが追加した経路:'
    managed_routes
}

plan() {
    is_root || return 1
    state=$(prefs_state 2>/dev/null) || state='取得失敗'
    say "ExitNodeAllowLANAccess: $state"
    say '追加候補（既存経路は上書きしない）:'
    collect_candidates
}


case "${1:-}" in
    -h|--help|'') show_help ;;
    status) status ;;
    plan) plan ;;
    apply) sync_routes ;;
    cleanup) cleanup_routes ;;
    *) show_help; exit 1 ;;
esac
